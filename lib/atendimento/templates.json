  "protocolo": "\n    <div>\n      <div class=\"title-box\"><i class=\"fas fa-id-card\"></i> Protocolo</div>\n      <div class=\"box\">\n        <p>Selecione uma opção</p>\n        <select df-opt>\n          <option value=\"Automático\">Automático</option>\n          <option value=\"NewActivities\">Novas Atividades</option>\n          <option value=\"URL\">URL</option>\n        </select>\n      </div>\n      <div class=\"box dbclickbox\" ondblclick=\"showpopup(event)\">\n        Clique duas vezes\n        <div class=\"modal\" style=\"display:none\">\n          <div class=\"modal-content\">\n            <span class=\"close\" onclick=\"closemodal(event)\">&times;</span>\n            Digite uma mensagem:\n            <textarea df-text placeholder=\"Digite uma mensagem...\" class=\"form-control\"></textarea>\n            URL da API:\n            <input type=\"text\" class=\"url-api-protocolo\" df-url_api>\n            <br/>\n            <button class=\"form-control btn-flow-validate\" onclick=\"validateApiProtocolo(event);\">Validar</button>\n            <button class=\"form-control btn-flow-save btn-save-urlapi-protocolo\" id=\"btnurlapiprotocolo\" onclick=\"closemodal(event); notificationApi();\">Salvar</button>\n            <br/><br/><br/><br/>\n            <span>\n              <b>Descrição da API de Protocolo</b>\n            </span>\n          </div>\n        </div>\n      </div>\n    </div>\n  ",
  "envio_mensagem": "\n    <div>\n      <div class=\"title-box\"><i class=\"fa fa-paper-plane\"></i> Opções</div>\n      <div class=\"box\">\n        <p><b>Dicas dos botões</b></p>\n        <p>A mensagem pode ter até 1024 caracteres. Compatível com emojis e formatação de texto, assim como links.</p>\n        <hr>\n        <p>Você pode ter até 3 botões. acima de 3 será gerado uma lista de botões que deve possuir no máximo de 10 elementos na lista.</p>\n        <hr>\n        <p>Inserir dados no campo</p>\n        <select df-customFields class=\"opt_customFields\">\n          <option value=\"\" selected>&nbsp;</option>\n        </select>\n        <br>\n        <hr>\n        <p>Botões</p>\n        <select df-buttons class=\"select-options-back\">\n          <option value=\"false\">Não</option>\n          <option value=\"true\">Sim</option>\n        </select>\n        <textarea id=\"example1\" df-title placeholder=\"Mensagem das opções\" class=\"form-control\"></textarea>\n        <br>\n        <hr>\n        <div class=\"field_wrapper\">\n          <div>\n            <input type=\"text\" class=\"number_option\" df-opt-1 style=\"width:30px;\" name=\"field_number[]\" value=\"\"/>\n            <input type=\"text\" df-text-1 class=\"item_option\" style=\"width:200px;\" name=\"field_name[]\" placeholder=\"Título da Opção\" value=\"\"/>\n            <input type=\"text\" df-description-1 class=\"item_description\" style=\"width:250px;\" name=\"field_description[]\" placeholder=\"Descrição da Opção\" value=\"\"/>\n            <a href=\"javascript:void(0);\" class=\"add_button\" style=\"text-decoration:none;\" title=\"Add field\">+</a>\n          </div>\n        </div>\n        <hr>\n      </div>\n    </div>\n  ",
  "timeConditions": "\n    <div>\n      <div class=\"title-box\"><i class=\"fa fa-clock\"></i> Condições de Tempo</div>\n      <div class=\"box\">\n        <p>Selecione uma opção</p>\n        <select df-timeConditions>\n        </select>\n      </div>\n    </div>\n  ",
  "envio_pergunta": "\n    <div>\n      <div class=\"title-box\"><i class=\"fab fa-telegram-plane\"></i> Enviar Mensagem</div>\n      <div class=\"box\">\n        Digite uma mensagem\n        <textarea df-template></textarea>\n      </div>\n    </div>\n  ",
