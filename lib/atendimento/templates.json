  "solicitar_dados": "\n    <div>\n      <div class=\"title-box\"><i class=\"fa fa-user-circle\"></i> Solicitar Dados</div>\n      <div class=\"box\">\n        <p>Selecione uma opção</p>\n        <select df-channel>\n          <option value=\"CPF/CNPJ\">CPF/CNPJ</option>\n          <option value=\"CPF\">CPF</option>\n          <option value=\"CNPJ\">CNPJ</option>\n        </select>\n      </div>\n      <div class=\"box dbclickbox\" ondblclick=\"showpopup(event)\">\n        Clique duas vezes\n        <div class=\"modal\" style=\"display:none\">\n          <div class=\"modal-content\">\n            <span class=\"close\" onclick=\"closemodal(event)\">&times;</span>\n            URL da API:\n            <input type=\"text\" class=\"url-api-dados\" df-url_api placeholder=\"\">\n            Digite uma mensagem:\n            <textarea df-text placeholder=\"Digite uma mensagem...\" class=\"form-control\"></textarea>\n            Mensagem de erro:\n            <textarea df-error placeholder=\"Mensagem de erro...\" class=\"form-control\"></textarea>\n            <input type=\"text\" class=\"cpfcnpj\" df-documentos_dados placeholder=\"Digite o número do documento\">\n            <p>Quantidade de Tentativas</p>\n            <select df-tentativas>\n              <option value=\"1\">1</option>\n              <option value=\"2\">2</option>\n              <option value=\"3\">3</option>\n              <option value=\"4\">4</option>\n              <option value=\"5\">5</option>\n            </select>\n            <hr>\n            <button class=\"form-control btn-save-urlapidados\" onclick=\"closemodal(event); notificationApi();\">Salvar</button>\n            <button class=\"form-control\" onclick=\"validateApiDados(event);\">Validar</button>\n          </div>\n        </div>\n      </div>\n    </div>\n  ",
