  "Send_DataStore": "\n    <div>\n      <div class=\"title-box\"><i class=\"fas fa-code\"></i> Enviar para DataStore</div>\n      <div class=\"box dbclickbox\" ondblclick=\"showpopup(event)\">\n        Clique duas vezes\n        <div class=\"modal\" style=\"display:none\">\n          <div class=\"modal-content\">\n            <span class=\"close\" onclick=\"closemodal(event)\">&times;</span>\n            URL da API:\n            <input type=\"text\" class=\"url-api\" df-url_api><br>\n            Método da API:\n            <select df-method class=\"api_method\">\n              <option value=\"POST\">POST</option>\n            </select>\n            <hr>\n            <button class=\"form-control\" onclick=\"validateSendDataStore(event);\">Validar</button>\n            <button class=\"form-control btn_Send_DataStore\" disabled onclick=\"closemodal(event); notificationApi();\">Salvar</button>\n          </div>\n        </div>\n      </div>\n    </div>\n  ",
  "Local_DataStore": "\n    <div>\n      <div class=\"title-box\">\n        <i class=\"fas fa-database\"></i> Local Datastore\n      </div>\n      <div class=\"box\">\n        <p>Escolha a base da dados</p>\n        <select df-local_datastore class=\"select-local_datastore\">\n          <option value=\"contact\" >Contato</option>\n          <option value=\"datastore\" selected >Datastore</option>\n        </select>\n      </div>\n    </div>\n  ",
  "envio_boletos": "\n\t\t\t\t<div>\n\t\t\t\t  <div class=\"title-box\"><i class=\"fas fa-file\"></i> Envio de Boletos </div>\n\t\t\t\t  <div class=\"box\">\n\t\t\t\t\t<p>Selecione uma opção</p>\n\t\t\t\t\t<select df-channel class=\"opt_boleto\">\n\t\t\t\t\t  <option value=\"Enviar Todos\">Enviar Todos</option>\n\t\t\t\t\t  <option value=\"Enviar Menu\">Enviar Menu</option>\n\t\t\t\t\t  <option value=\"Catalog\">Catálogo</option>\n\t\t\t\t\t</select>\n\t\t\t\t  </div>\n\t\t\t\t  <div class=\"box dbclickbox\" ondblclick=\"showpopup(event)\">\n\t\t\t\t\tClique duas vezes\t\t\t\t\t<div class=\"modal\" style=\"display:none\">\n\t\t\t\t\t  <div class=\"modal-content\">\n\t\t\t\t\t\t<span class=\"close\" onclick=\"closemodal(event)\">&times;</span>\n\t\t\t\t\t\t<p>Digite uma mensagem:</p>\n\t\t\t\t\t\t<textarea df-text placeholder=\"Digite uma mensagem...\" class=\"form-control\"></textarea>\n\t\t\t\t\t\t<p>Informe a URL da API que lista os boletos:</p>\n\t\t\t\t\t\t<input type=\"text\" df-url_list>\n\t\t\t\t\t\t<p>Informe a URL da API que enviar os boletos:</p>\n\t\t\t\t\t\t<input type=\"text\" df-url_send>\n\t\t\t\t\t\t<hr>\t\t\t\t\t\n\t\t\t\t\t\t<b>Opção do Menu Customizado</b>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p>Opção</p> \n\t\t\t\t\t\t<input type=\"text\" df-menuOptions >\n\t\t\t\t\t\t<p>Mensagem</p> \n\t\t\t\t\t\t<input type=\"text\" df-menuMessage >\n\t\t\t\t\t\t<p>Voltar para o menu de opções</p> \n\t\t\t\t\t\t<select df-menuTransfer class=\"select-options-back\">\n\t\t\t\t\t\t\t<option selected=\"\">Selecione</option><option value=\"2\">2</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t\t<hr>\n\t\t\t\t\t\t<button class=\"form-control\" onclick=\"closemodal(event); notificationApi();\">Salvar</button>\n\t\t\t\t\t  </div>\n\t\t\t\t\t</div>\n\t\t\t\t  </div>\n\t\t\t\t</div>\n  ",
  "tabulation": "\n    <div>\n      <div class=\"title-box\"><i class=\"fa fa-users\"></i> Tabulação</div>\n      <div class=\"box\">\n        <p>Selecione uma opção</p>\n        <select df-tabulation class=\"select-tabulation\">\n        </select>\n        <input type=\"text\" df-id class=\"df-id\">\n      </div>\n    </div>\n  "
}
